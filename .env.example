# Copy to .env and source it, or export these directly.
# The app reads plain environment variables — no .env loader is built in.

# HTTP listen port
PORT=8080

# Scheduler interval: Go duration ("30s", "15m", "1h30m") or bare seconds ("900").
# Set to 0 to disable the background scheduler entirely.
SCRAPE_INTERVAL=15m

# How many assets to keep after stablecoins and derivatives are filtered out.
# The crawler fetches 2x this (capped at 1000) so there is headroom to filter.
TOP_N=200

# Per-request timeout for the crawler
SCRAPE_TIMEOUT=45s

# Run one crawl immediately at startup
SCRAPE_ON_START=true
